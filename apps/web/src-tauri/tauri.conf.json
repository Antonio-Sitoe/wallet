{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallet",
  "version": "0.3.0",
  "identifier": "com.antoniositoe.wallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "VITE_DESKTOP=1 npm run dev",
    "beforeBuildCommand": "VITE_DESKTOP=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Wallet",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Gestão financeira pessoal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
