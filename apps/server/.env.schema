# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/infrastructure/config/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# WhatsApp (Evolution API). Sem estas variáveis a ligação do número fica desligada.
# @optional @type=string(minLength=32)
WHATSAPP_WEBHOOK_SECRET=

# @optional @type=url
EVOLUTION_URL=

# @optional @public
EVOLUTION_INSTANCE=

# @optional
EVOLUTION_API_KEY=

# Número do bot, só dígitos com o indicativo (ex.: 258833204038)
# @optional @public
WHATSAPP_BOT_NUMBER=
